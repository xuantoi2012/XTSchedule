<xt:XTCadWindow x:Class="XTSchedule.UI.Views.MainWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:xt="http://schemas.xtstyle.com/cad/wpf"
                xmlns:controls="clr-namespace:XTSchedule.UI.Controls"
                mc:Ignorable="d"
                Title="{Binding WindowTitle}"
                Width="1280"
                Height="760"
                MinWidth="960"
                MinHeight="560"
                Background="{DynamicResource CadWorkspaceBackground}">
    <xt:XTCadWindow.Resources>
        <Style x:Key="ScheduleToolButton" TargetType="{x:Type xt:XTButton}" BasedOn="{StaticResource XTToolButton}">
            <Setter Property="MinWidth" Value="76"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>
        <Style x:Key="SchedulePrimaryButton" TargetType="{x:Type xt:XTButton}" BasedOn="{StaticResource XTPrimaryButton}">
            <Setter Property="MinWidth" Value="76"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>
        <Style x:Key="ScheduleSuccessButton" TargetType="{x:Type xt:XTButton}" BasedOn="{StaticResource XTSuccessButton}">
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>
        <Style x:Key="ScheduleDangerButton" TargetType="{x:Type xt:XTButton}" BasedOn="{StaticResource XTDangerButton}">
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,14,6"/>
        </Style>
    </xt:XTCadWindow.Resources>

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource CadToolbarBackground}"
                BorderBrush="{DynamicResource CadBorder}"
                BorderThickness="0,0,0,1"
                Padding="8,8,8,2">
            <WrapPanel>
                <xt:XTButton Text="Mới" Style="{StaticResource SchedulePrimaryButton}" Command="{Binding NewCommand}"/>
                <xt:XTButton Text="Mở" Style="{StaticResource ScheduleToolButton}" Command="{Binding OpenCommand}"/>
                <xt:XTButton Text="Lưu" Style="{StaticResource ScheduleToolButton}" Command="{Binding SaveCommand}"/>
                <xt:XTButton Text="Thêm nhóm" Style="{StaticResource ScheduleToolButton}" MinWidth="104" Command="{Binding AddGroupCommand}"/>
                <xt:XTButton Text="Thêm việc" Style="{StaticResource ScheduleToolButton}" MinWidth="96" Command="{Binding AddTaskCommand}"/>
                <xt:XTButton Text="Xóa" Style="{StaticResource ScheduleDangerButton}" Command="{Binding DeleteCommand}"/>
                <xt:XTButton Text="Lên" Style="{StaticResource ScheduleToolButton}" MinWidth="64" Command="{Binding MoveUpCommand}"/>
                <xt:XTButton Text="Xuống" Style="{StaticResource ScheduleToolButton}" Command="{Binding MoveDownCommand}"/>
                <xt:XTButton Text="Indent" Style="{StaticResource ScheduleToolButton}" Command="{Binding IndentCommand}"/>
                <xt:XTButton Text="Outdent" Style="{StaticResource ScheduleToolButton}" MinWidth="84" Command="{Binding OutdentCommand}"/>
                <xt:XTButton Text="Paste" Style="{StaticResource ScheduleToolButton}" Command="{Binding PasteRowsCommand}"/>
                <xt:XTButton Text="-1 ngày" Style="{StaticResource ScheduleToolButton}" MinWidth="82" Command="{Binding ShiftBackCommand}"/>
                <xt:XTButton Text="+1 ngày" Style="{StaticResource ScheduleToolButton}" MinWidth="82" Command="{Binding ShiftForwardCommand}"/>
                <xt:XTButton Text="Nối tiếp" Style="{StaticResource ScheduleToolButton}" MinWidth="86" Command="{Binding SequenceCommand}"/>
                <xt:XTButton Text="Xem trước" Style="{StaticResource ScheduleToolButton}" MinWidth="96"/>
                <xt:XTButton Text="Xuất PDF" Style="{StaticResource ScheduleSuccessButton}"/>
                <xt:XTButton Text="Xuất Word" Style="{StaticResource ScheduleToolButton}" MinWidth="96"/>
            </WrapPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource CadToolbarBackground}"
                BorderBrush="{DynamicResource CadBorder}"
                BorderThickness="0,1,0,0"
                Padding="10,6">
            <TextBlock Foreground="{DynamicResource CadTextSecondary}"
                       Text="{Binding Tasks.Count, StringFormat={}{0} công việc}"/>
        </Border>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="520"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <xt:XTDataGrid Grid.Column="0"
                           ItemsSource="{Binding Tasks}"
                           SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                           AutoGenerateColumns="False"
                           CanUserAddRows="False"
                           RowHeight="32"
                           HeadersVisibility="Column"
                           SelectionMode="Extended"
                           SelectionUnit="FullRow">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="STT" Binding="{Binding Number}" Width="70"/>
                    <DataGridTextColumn Header="Nội dung công việc" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                    <DataGridTemplateColumn Header="Bắt đầu" Width="132">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <xt:XTDatePicker SelectedDate="{Binding StartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernDatePicker}"
                                                 Language="vi-VN"
                                                 MinWidth="120"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <xt:XTDatePicker SelectedDate="{Binding StartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernDatePicker}"
                                                 Language="vi-VN"
                                                 MinWidth="120"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Kết thúc" Width="132">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <xt:XTDatePicker SelectedDate="{Binding FinishDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernDatePicker}"
                                                 Language="vi-VN"
                                                 MinWidth="120"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <xt:XTDatePicker SelectedDate="{Binding FinishDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernDatePicker}"
                                                 Language="vi-VN"
                                                 MinWidth="120"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Số ngày"
                                        Binding="{Binding Duration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Width="86"/>
                </DataGrid.Columns>
            </xt:XTDataGrid>

            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource CadBorder}"/>

            <ScrollViewer Grid.Column="2"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Background="{DynamicResource CadPanelBackground}">
                <controls:ScheduleTimelineControl ItemsSource="{Binding Tasks}"
                                                  MinWidth="720"
                                                  MinHeight="520"/>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</xt:XTCadWindow>
