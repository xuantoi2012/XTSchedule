<xt:XTCadWindow x:Class="XTSchedule.UI.Views.PrintPreviewWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:xt="http://schemas.xtstyle.com/cad/wpf"
                Title="Xem trước khi in" Width="900" Height="720"
                WindowStartupLocation="CenterOwner"
                Background="{DynamicResource CadWorkspaceBackground}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="12,8" Background="{DynamicResource CadToolbarBackground}"
                BorderBrush="{DynamicResource CadBorder}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="txtPageCount" VerticalAlignment="Center" Margin="0,0,16,0"
                           Foreground="{DynamicResource CadTextSecondary}"/>
                <xt:XTButton Text="In..." Width="90" Style="{StaticResource XTPrimaryButton}" Click="Print_Click"/>
                <xt:XTButton Text="Đóng" Width="80" Margin="8,0,0,0" Click="Close_Click"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                      Background="#FF3A3A3A">
            <ItemsControl x:Name="pagesList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" Margin="20"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,16" Background="White" Effect="{x:Null}">
                            <Image Source="{Binding}" Stretch="Uniform"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</xt:XTCadWindow>
